  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: DragonGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Dragon blood tree (Socotra), crooked. A lumpy kinked trunk of three to

    // five segments, then sympodial forking: every arm is two kinked half-steps

    // with a lumpy width, a roll upright and a pitch toward the sky, then a

    // two- or three-way fork; the crown closes into an umbrella because every

    // arm keeps bending back toward vertical. Leaves only at the tips, as spiky

    // tufts of needle cards.

    //

    // Per-seed variation: facing, trunk segment count and width, fork

    // half-angle a (28..46), shrink s (0.76..0.81), first arm length, every

    // kink, roll and fork.

    

    #define TP  0.74

    #define MIN 0.26

    #define PHI 137.5

    

    // X 1, T 5 + 1, A: 1.7 * 0.81^n < 0.26 -> 9, U 1. 17.

    #iterations: 21

    

    #axiom: X

    

    X -> /(rand(360)) T(rand(3,5), rand(0.6,0.8), rand(28,46), rand(0.76,0.81))

    

    // T(k,w,a,s): the trunk: lumpy, kinked, rolling, lifting.

    T(k,w,a,s) : k > 0 -> !(w*rand(0.88,1.15)) F(rand(0.5,0.9)) &(rand(-10,10)) +(rand(-10,10)) /(rand(360)) $ ^(rand(1,4)) T(k-1, w*0.96, a, s)

    T(k,w,a,s) : k <= 0 -> !(w) F(0.2) A(rand(1.4,1.7), w, a, s)

    

    // A(l,w,a,s): a live arm. Two kinked half-steps, then the lift, then a fork.

    A(l,w,a,s) : l >= MIN : 0.72 -> !(w*rand(0.85,1.15)) F(l*0.5*rand(0.7,1.3)) &(rand(-14,14)) +(rand(-14,14)) /(rand(-40,40)) !(w*rand(0.9,1.1)) F(l*0.5*rand(0.7,1.3)) $ ^(10) !(w*TP) [ +(a+rand(-8,8)) /(rand(360)) A(l*s*rand(0.9,1.06), w*TP, a, s) ] [ -(a+rand(-8,8)) /(rand(360)) A(l*s*rand(0.9,1.06), w*TP, a, s) ]

    A(l,w,a,s) : l >= MIN : 0.28 -> !(w*rand(0.85,1.15)) F(l*0.5*rand(0.7,1.3)) /(rand(360)) &(rand(15,30)) !(w*rand(0.9,1.1)) F(l*0.5*rand(0.7,1.3)) $ ^(10) !(w*TP) [ +(a*0.7) /(rand(360)) A(l*s, w*TP, a, s) ] [ -(a*0.7) /(rand(360)) A(l*s*0.92, w*TP*0.92, a, s) ] [ &(a*0.9) /(PHI) A(l*s*0.85, w*TP*0.85, a, s) ]

    

    // Tip: a short stub and a tuft. The tuft size follows the tip width.

    A(l,w,a,s) : l < MIN -> !(w) F(l*0.7) U(w*16)

    

    // U(s): eight stiff leaves fanning out of the tip, plus one straight up.

    U(s) -> [ ^(52) L(s) ] /(45) [ ^(55) L(s*0.95) ] /(45) [ ^(52) L(s) ] /(45) [ ^(55) L(s*0.95) ] /(45) [ ^(52) L(s) ] /(45) [ ^(55) L(s*0.95) ] /(45) [ ^(52) L(s) ] /(45) [ ^(55) L(s*0.95) ] [ L(s*0.9) ]'
  iterations: 21
