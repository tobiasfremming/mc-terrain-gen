  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: DragonGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Dragon blood tree (Socotra). A stout trunk, then dichotomous forking over and

    // over: every branch ends in a fork, every fork''s arms curve back toward the

    // sky, and the crown closes into an umbrella. Leaves only exist at the very

    // tips, as spiky tufts.

    //

    // The umbrella comes from two things working together: a wide fork angle so

    // arms spread, and $ ^(UP) after every segment -- roll upright, then pitch

    // toward WORLD up -- so every arm bends back vertical no matter which way it

    // left its fork. Without the $ the pitch would be about the arm''s own axis

    // and the crown would corkscrew.

    //

    // Per-seed variation: X draws the trunk segment count (2..5), the trunk

    // width, the fork half-angle a (30..50) and the per-generation shrink s

    // (0.77..0.81) ONCE, and carries a and s through every A module. Trunk

    // segments then draw their own length and lean.

    

    #define UP   10       // degrees each segment bends back toward the sky

    #define TP   0.74     // each generation thinner

    #define MIN  0.30     // arm length at which a branch ends in a tuft

    #define PHI  137.5

    

    // X 1, T up to 5, A: 1.7 * 0.81^n < 0.30 -> 9 generations, U 1. 16.

    #iterations: 18

    

    #axiom: X

    

    // rand() in an axiom is evaluated once at parse time, outside the seed;

    // drawing inside a rule is what makes every seed a different tree.

    X -> !(rand(0.5,0.72)) T(rand(2,5), rand(0.5,0.72), rand(30,50), rand(0.77,0.81))

    

    // T(k,w,a,s): the trunk, k segments of random length, each leaning a little.

    T(k,w,a,s) : k > 0 -> !(w) F(rand(0.8,1.3)) &(rand(-5,5)) /(rand(360)) T(k-1, w*0.96, a, s)

    T(k,w,a,s) : k <= 0 -> A(rand(1.4,1.7), w, a, s)

    

    // A(l,w,a,s): a live arm. Mostly a clean fork; sometimes a three-way crown

    // split so the umbrella is not a perfect binary tree.

    A(l,w,a,s) : l >= MIN : 0.72 -> F(l) $ ^(UP) !(w*TP) [ +(a+rand(-8,8)) /(rand(360)) A(l*s*rand(0.9,1.06), w*TP, a, s) ] [ -(a+rand(-8,8)) /(rand(360)) A(l*s*rand(0.9,1.06), w*TP, a, s) ]

    A(l,w,a,s) : l >= MIN : 0.28 -> F(l) $ ^(UP) !(w*TP) [ +(a*0.7) /(rand(360)) A(l*s, w*TP, a, s) ] [ -(a*0.7) /(rand(360)) A(l*s*0.92, w*TP*0.92, a, s) ] [ &(a*0.9) /(PHI) A(l*s*0.85, w*TP*0.85, a, s) ]

    

    // Tip: a short stub and a tuft. The tuft size follows the tip width.

    A(l,w,a,s) : l < MIN -> F(l*0.7) U(w*16)

    

    // U(s): eight stiff leaves fanning out of the tip, plus one straight up.

    U(s) -> [ ^(52) L(s) ] /(45) [ ^(55) L(s*0.95) ] /(45) [ ^(52) L(s) ] /(45) [ ^(55) L(s*0.95) ] /(45) [ ^(52) L(s) ] /(45) [ ^(55) L(s*0.95) ] /(45) [ ^(52) L(s) ] /(45) [ ^(55) L(s*0.95) ] [ L(s*0.9) ]

'
  iterations: 18
