MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: DandelionGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Grandelion (tree-sized dandelion, concept "Grandelion & Seed"). One tall

    // trunk-thick stalk that leans and curves as it rises, a head of spokes

    // radiating in every direction, a pappus disc at the end of each spoke, and

    // a few soft tendrils hanging from the head''s centre.

    //

    // Per-seed variation: stalk segment count (10..18, so 6 to 11 m tall), base

    // width, lean direction, and spoke count (24..40).

    

    #define PHI 137.5

    

    // X 1, S up to 18 + 1, H 1, P up to 20, Q 1; W 9 in parallel. 42.

    #iterations: 44

    

    #axiom: X

    

    X -> /(rand(360)) !(0.3) S(rand(10,18), rand(0.26,0.34))

    

    // S(k, w): the stalk. Each segment pitches a little in a random direction so

    // the whole thing arcs, and thins as it goes.

    S(k,w) : k > 0 -> !(w) F(0.62) /(rand(-20,20)) &(rand(1,4)) S(k-1, w*0.94)

    S(k,w) : k <= 0 -> !(w) F(0.3) H

    

    // H: the head. A ball at the centre, spokes, and tendrils hanging below.

    H -> O(0.36) P(rand(12,20)) [ &(150) /(rand(360)) W(9) ] [ &(140) /(rand(360)) W(8) ] [ &(160) /(rand(360)) W(7) ] [ &(145) /(rand(360)) W(8) ] [ &(155) /(rand(360)) W(6) ]

    

    // P(n): two spokes per step, spiralling, each pitched somewhere between

    // straight up and drooping below horizontal.

    P(n) : n > 0 -> [ /(PHI*n) &(rand(20,115)) Q(rand(1.4,2.2), 0.028) ] [ /(PHI*n + 180 + rand(-30,30)) &(rand(20,115)) Q(rand(1.2,2.0), 0.026) ] P(n-1)

    P(n) : n <= 0 -> $

    

    // Q(l, w): one spoke, two segments with a bend, then the pappus disc.

    Q(l,w) -> !(w) F(l*0.5) &(rand(-10,10)) /(rand(360)) F(l*0.5) D(0.6) E(0.12)

    

    // W(k): a tendril: thin, curling down under its own weight.

    W(k) : k > 0 -> !(0.045) F(0.28) &(rand(5,14)) /(rand(-15,15)) W(k-1)

    W(k) : k <= 0 -> E(0.07)

'
  iterations: 44
