  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: AnemoneGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Anemone bloom. A squat bulb sits in a ring of big magenta petals; from its

    // top rise thirty to fifty waving tentacles, each curving its own way and

    // tipped with a glowing bead.

    //

    // Per-seed variation: facing, bulb size, petal count, tentacle count, per

    // tentacle the length, curve and twist.

    

    #define PHI 137.5

    

    // X 1, P 10, A 25 (two a step), T 14 + 1. 41.

    #iterations: 43

    

    #axiom: X

    

    X -> /(rand(360)) f(0.3) O(rand(0.8,1.2)) P(rand(6,10)) f(0.3) A(rand(15,25))

    

    // P(n): base petals, lying out flat-ish.

    P(n) : n > 0 -> [ /(PHI*n) &(rand(70,95)) f(0.9) L(1.6) ] P(n-1)

    P(n) : n <= 0 -> $

    

    // A(n): two tentacles per step.

    A(n) : n > 0 -> [ /(PHI*2*n) &(rand(5,60)) !(0.1) T(rand(8,14), 0.1, rand(-6,6), rand(-4,4)) ] [ /(PHI*(2*n+1)) &(rand(5,60)) !(0.1) T(rand(8,14), 0.1, rand(-6,6), rand(-4,4)) ] A(n-1)

    A(n) : n <= 0 -> $

    

    // T(k,w,p,r): a tentacle: constant pitch p (a wave) and roll r.

    T(k,w,p,r) : k > 0 -> !(w) F(0.3) &(p + rand(-3,3)) /(r*4) T(k-1, w*0.95, p, r)

    T(k,w,p,r) : k <= 0 -> !(w) F(0.2) f(0.12) E(0.22)

'
  iterations: 43
