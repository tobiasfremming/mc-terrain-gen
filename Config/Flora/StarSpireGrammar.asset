MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: StarSpireGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Star spires (the red star-crowned stalks in the savanna painting, flora

    // board). Three to six stalks rise from one root in a loose fan, each ringed

    // at every joint, each ending in a bulb and a crown of three whorls of flat

    // pointed blades: eight crimson outer blades near horizontal, eight orange

    // inner ones steeper, five yellow ones almost upright, and a centre spike,

    // with a skirt of dead blades hanging below.

    //

    // Per-seed variation: stalk count, per stalk the segment count (5..14, so

    // 2.5 to 6.5 m), width and lean, and per crown the whorl angles and blade

    // lengths.

    

    // X 1, Q 6, S 14 + 1, W/I/J/D 8. 30.

    #iterations: 32

    

    #axiom: !(0.3) X

    

    X -> Q(rand(3,6))

    

    // Q(n): one stalk per step.

    Q(n) : n > 0 -> [ &(rand(0,45)) /(rand(360)) S(rand(5,14), rand(0.1,0.17)) ] Q(n-1)

    Q(n) : n <= 0 -> $

    

    // S(k,w): stalk segment with a joint ring, wandering and righting itself.

    S(k,w) : k > 0 -> !(w) F(0.45) N(w*2.2) &(rand(-3,3)) /(rand(-25,25)) $ ^(rand(1,3)) S(k-1, w*0.965)

    S(k,w) : k <= 0 -> !(w*1.3) F(0.25) O(w*3) D(6, rand(105,125), rand(0.9,1.2)) /(30) W(8, rand(62,80), rand(1.1,1.5)) /(22) I(8, rand(35,50), rand(0.85,1.15)) /(36) J(5, rand(10,22), rand(0.6,0.8)) f(0.1) Y(0.8)

    

    W(n,a,l) : n > 0 -> [ /(45*n + rand(-8,8)) &(a + rand(-5,5)) f(l*0.5) V(l) ] W(n-1, a, l)

    W(n,a,l) : n <= 0 -> $

    I(n,a,l) : n > 0 -> [ /(45*n + rand(-8,8)) &(a + rand(-5,5)) f(l*0.5) Y(l) ] I(n-1, a, l)

    I(n,a,l) : n <= 0 -> $

    J(n,a,l) : n > 0 -> [ /(72*n + rand(-8,8)) &(a + rand(-5,5)) f(l*0.5) Z(l) ] J(n-1, a, l)

    J(n,a,l) : n <= 0 -> $

    D(n,a,l) : n > 0 -> [ /(60*n + rand(-10,10)) &(a + rand(-8,8)) f(l*0.5) U(l) ] D(n-1, a, l)

    D(n,a,l) : n <= 0 -> $

'
  iterations: 32
