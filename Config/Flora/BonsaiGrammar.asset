%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: BonsaiGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Large bonsai, twisted. The trunk is the plant: it leaves the ground

    // leaning thirty degrees, and every short segment yaws the same way round

    // the vertical (a corkscrew) while pitching out or back in, so the trunk

    // spirals up in an S; one segment in four is a sharp kink. It tapers hard

    // and is lumpy. Dead stubs (pale cones) stick out of the lower trunk, and

    // the apex is a deadwood spike. Limbs leave from the fourth segment on,

    // crooked, forking twice, and every fork and tip carries a small flat

    // clump of foliage balls sitting on top of the branch, so foliage is

    // layered clouds with the trunk visible between them. Surface roots flare.

    //

    // Per-seed variation: facing, twist direction, lean, trunk length, every

    // bend and kink, which segments carry limbs or dead stubs, every limb

    // kink and fork, clump sizes.

    

    // X 1, W 1, T 15, P 14, N 20, L 8, N 16, C 1, G 7. 83.

    #iterations: 86

    

    #axiom: X

    

    X -> /(rand(360)) W(rand(1.6,2.1))

    W(w) : 0.5 -> !(w) [ R(rand(6,9), w) ] &(rand(25,35)) T(rand(12,15), 1.4, w, 1, 0)

    W(w) : 0.5 -> !(w) [ R(rand(6,9), w) ] &(rand(25,35)) T(rand(12,15), 1.4, w, -1, 0)

    

    // R(n,w): surface roots, flared, tapering to nothing.

    R(n,w) : n > 0 -> [ /(rand(360)) f(rand(0,0.4)) &(rand(85,100)) !(w*rand(0.3,0.45)) F(rand(1.5,3)) &(rand(0,12)) +(rand(-30,30)) !(w*0.18) F(rand(1,2.2)) &(rand(0,10)) !(w*0.06) F(rand(0.6,1.2)) ] R(n-1, w)

    R(n,w) : n <= 0 -> $

    

    // T(k,l,w,y,i): the trunk. y is the twist direction. Each segment: yaw

    // round the vertical by 30..55 in direction y, pitch out or in, pulled

    // back toward vertical harder the higher it gets; one in four a kink.

    // Limbs from i >= 3, dead stubs on i < 5.

    T(k,l,w,y,i) : k > 0 && i < 3 : 0.75 -> !(w*rand(0.85,1.25)) F(l*rand(0.7,1.2)) $ +(y*rand(30,55)) &(rand(-12,28)) $ ^(rand(4,10)) Z(i, w) T(k-1, l, w*0.90, y, i+1)

    T(k,l,w,y,i) : k > 0 && i < 3 : 0.25 -> !(w*rand(0.9,1.3)) F(l*rand(0.5,0.8)) /(rand(360)) &(rand(30,50)) $ +(y*rand(30,55)) $ ^(rand(6,14)) Z(i, w) T(k-1, l, w*0.90, y, i+1)

    T(k,l,w,y,i) : k > 0 && i >= 3 : 0.45 -> !(w*rand(0.85,1.25)) F(l*rand(0.7,1.2)) $ +(y*rand(30,55)) &(rand(-12,28)) $ ^(rand(5,12) + i*0.8) Z(i, w) [ $ +(rand(360)) P(14) N(rand(14,20)) L(rand(6,8), 1.3, w*0.45, rand(5,9), 0) ] T(k-1, l, w*0.90, y, i+1)

    T(k,l,w,y,i) : k > 0 && i >= 3 : 0.35 -> !(w*rand(0.85,1.25)) F(l*rand(0.7,1.2)) $ +(y*rand(30,55)) &(rand(-12,28)) $ ^(rand(5,12) + i*0.8) Z(i, w) T(k-1, l, w*0.90, y, i+1)

    T(k,l,w,y,i) : k > 0 && i >= 3 : 0.2 -> !(w*rand(0.9,1.3)) F(l*rand(0.5,0.8)) /(rand(360)) &(rand(30,50)) $ +(y*rand(30,55)) $ ^(rand(7,16) + i*0.8) Z(i, w) [ $ +(rand(360)) P(14) N(rand(14,20)) L(rand(6,8), 1.3, w*0.45, rand(5,9), 0) ] T(k-1, l, w*0.90, y, i+1)

    T(k,l,w,y,i) : k <= 0 -> [ $ +(rand(360)) P(14) N(rand(19,23)) L(rand(4,5), 0.8, w*0.5, rand(4,8), 0) ] [ $ +(rand(360)) P(14) N(rand(19,23)) L(rand(4,5), 0.8, w*0.5, rand(4,8), 0) ] !(w*0.7) F(l*0.4) N(12) f(0.7) J(rand(1.4,2.0))

    

    // P(n): point at the ground in 10-degree steps; with N(n) after it a limb''s

    // elevation no longer depends on how far the twisted trunk leans.

    P(n) : n > 0 -> $ &(10) P(n-1)

    P(n) : n <= 0 -> $

    

    // Z(i,w): dead stub hook on the lower trunk, one in three segments.

    Z(i,w) : i < 6 : 0.33 -> [ /(rand(360)) &(rand(50,85)) f(w*0.5) J(rand(0.9,1.6)) ]

    Z(i,w) : i < 6 : 0.67 -> $

    Z(i,w) : i >= 6 -> $

    

    // L(k,l,w,u,i): the limb: crooked, leaving level or dipping, sweeping up,

    // forking at k = 4 and k = 2, a clump at every fork and tip.

    L(k,l,w,u,i) : k > 4.5 : 0.75 -> !(w*rand(0.85,1.2)) F(l*rand(0.6,1.4)) &(rand(-20,20)) +(rand(-20,20)) /(rand(-40,40)) $ ^(u*rand(0.3,1.9)) L(k-1, l*0.96, w*0.95, u, i+1)

    L(k,l,w,u,i) : k > 4.5 : 0.25 -> !(w*rand(0.9,1.25)) F(l*rand(0.5,0.9)) /(rand(360)) &(rand(20,40)) $ ^(u*rand(0.5,1.5)) L(k-1, l*0.96, w*0.95, u, i+1)

    L(k,l,w,u,i) : k > 3.5 && k <= 4.5 -> !(w*rand(0.9,1.2)) F(l*rand(0.7,1.2)) $ ^(u) [ N(16) C(rand(0.7,1.1)) ] !(w*0.78) [ +(rand(25,50)) /(rand(-40,40)) &(rand(-15,15)) L(k-1, l*0.94, w*0.78, u, i+1) ] [ -(rand(25,50)) /(rand(-40,40)) &(rand(-15,15)) L(k-1, l*0.94, w*0.78, u, i+1) ]

    L(k,l,w,u,i) : k > 2.5 && k <= 3.5 : 0.75 -> !(w*rand(0.85,1.2)) F(l*rand(0.6,1.4)) &(rand(-20,20)) +(rand(-20,20)) /(rand(-40,40)) $ ^(u*rand(0.3,1.9)) L(k-1, l*0.96, w*0.95, u, i+1)

    L(k,l,w,u,i) : k > 2.5 && k <= 3.5 : 0.25 -> !(w*rand(0.9,1.25)) F(l*rand(0.5,0.9)) /(rand(360)) &(rand(20,40)) $ ^(u*rand(0.5,1.5)) L(k-1, l*0.96, w*0.95, u, i+1)

    L(k,l,w,u,i) : k > 1.5 && k <= 2.5 -> !(w*rand(0.9,1.2)) F(l*rand(0.7,1.2)) $ ^(u) [ N(16) C(rand(0.7,1.1)) ] !(w*0.78) [ +(rand(25,50)) /(rand(-40,40)) &(rand(-15,15)) L(k-1, l*0.94, w*0.78, u, i+1) ] [ -(rand(25,50)) /(rand(-40,40)) &(rand(-15,15)) L(k-1, l*0.94, w*0.78, u, i+1) ]

    L(k,l,w,u,i) : k > 0 && k <= 1.5 -> !(w*rand(0.85,1.2)) F(l*rand(0.6,1.4)) &(rand(-20,20)) +(rand(-20,20)) /(rand(-40,40)) $ ^(u*rand(0.3,1.9)) L(k-1, l*0.96, w*0.95, u, i+1)

    L(k,l,w,u,i) : k <= 0 -> !(w) F(l*0.4) N(16) C(rand(0.8,1.3))

    

    // N(n): level the heading in 5-degree steps.

    N(n) : n > 0 -> $ ^(5) N(n-1)

    N(n) : n <= 0 -> $

    

    // C(s): a clump: a flat ring of foliage balls on top of the branch, one in

    // the middle, the rest around it, all slightly above the wood.

    C(s) -> f(s*0.25) [ E(s*0.9) ] G(rand(4,7), s)

    G(n,s) : n > 0 -> [ /(rand(360)) &(90) f(s*rand(0.4,0.8)) ^(90) f(s*rand(-0.1,0.15)) E(s*rand(0.5,0.85)) ] G(n-1, s)

    G(n,s) : n <= 0 -> $'
  iterations: 86
