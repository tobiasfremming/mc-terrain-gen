  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: WorldColonyGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Everywhere: sparse herb tufts, three to six a plot when a plot has any.

    #iterations: 8

    #axiom: X

    X -> +(rand(360)) f(rand(0,6)) V(rand(3,6))

    V(n) : n > 0 -> [ +(rand(360)) f(rand(2,8)) h(rand(0.7,1.2)) ] V(n-1)

    V(n) : n <= 0 -> f(0)'
  iterations: 8
