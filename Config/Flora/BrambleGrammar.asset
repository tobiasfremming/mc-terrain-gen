--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: BrambleGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// A bramble. The wild one: nothing here points in a predictable direction.

    //

    //
    The other grammars use FIXED angles -- &(34), /(137.5) -- so their branches

    //
    are irregular only because of WHICH rule fires. This one draws every angle

    //
    per branch with rand(), so two branches made by the same rule still go

    //
    different ways. That is what the expression language is for; rand() is never

    //
    constant-folded, and it is seeded, so a given seed still rebuilds identically.

    //

    //  
    rand()          -> [0,1)

    //   rand(hi)        -> [0,hi)

    //   rand(lo,hi)    
    -> [lo,hi)

    //

    // Divergence also comes from a THREE-way split being
    the most likely rule, and

    // from lengths jittering by rand(0.86,1.08) so
    siblings never match. Growth is

    // still guaranteed to stop: SH*max(rand)
    = 0.80*1.08 = 0.864 < 1, so every

    // branch shrinks no matter how the dice
    land.


    #define SPRAY 40      // base angle a side branch leaves at

    #define
    JIT   26      // +/- wander added to every branch angle

    #define SH    0.80   
    // each generation shorter

    #define TP    0.77    // ...and thinner

    #define
    MIN   0.135   // length at which a shoot finishes

    #define BEND  11     
    // how far a length of wood may wander off straight


    // +1 for C(l) to expand
    -- see the rule below.

    #iterations: 17


    #axiom: !(0.20) W(1.5, 0.20)


    //
    C(l): a curved step. Two short segments with a bend between them, so a run

    //
    of wood is never a straight line. Two rather than three here because this

    //
    plant already has ~600 branches and each sub-step is another GameObject.

    C(l)
    -> F(l*0.5) &(rand(0-BEND,BEND)) /(rand(360)) F(l*0.5)


    // Two-way fork,
    both arms jittered and randomly rolled.

    W(l,w) : l >= MIN : 0.30 -> C(l)
    !(w*TP) [ &(SPRAY + rand(-JIT,JIT)) /(rand(360)) W(l*SH*rand(0.86,1.08), w*TP)
    ] [ &(0 - SPRAY + rand(-JIT,JIT)) /(rand(360)) W(l*SH*rand(0.86,1.08), w*TP*0.95)
    ] L(w*3)


    // Three-way spray -- the most likely rule, and the reason this
    thing is dense.

    W(l,w) : l >= MIN : 0.32 -> C(l) !(w*TP) [ &(SPRAY*1.5 +
    rand(-JIT,JIT)) /(rand(360)) W(l*SH*0.82, w*TP*0.88) ] [ ^(SPRAY*0.45 + rand(-JIT,JIT))
    /(rand(360)) W(l*SH*0.95, w*TP*0.92) ] [ &(rand(-75,75)) /(rand(360)) W(l*SH*0.72,
    w*TP*0.82) ] L(w*3.4)


    // A wandering climb: random length, random lean,
    random spin.

    W(l,w) : l >= MIN : 0.20 -> C(l*rand(0.9,1.25)) &(rand(-18,18))
    /(rand(360)) !(w*TP) W(l*SH, w*TP*0.98) L(w*3.2)


    // A stubby side shoot
    thrown off at a wide random angle.

    W(l,w) : l >= MIN : 0.18 -> C(l) !(w*TP)
    [ &(rand(55,105)) /(rand(360)) W(l*SH*0.6, w*TP*0.7) ] W(l*SH, w*TP) L(w*2.8)


    //
    Thick tips carry berries, thin ones carry buds.

    W(l,w) : l < MIN : w > 
    0.016 -> F(l) K(w*8) L(w*3)

    W(l,w) : l < MIN : w <= 0.016 -> F(l) S(w*14)
    L(w*2.6)

'
  iterations: 15
