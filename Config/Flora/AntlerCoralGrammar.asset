--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: AntlerCoralGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Antler coral. A land coral: every branch splits into two or three, seven

    // generations deep, with a fresh roll at each split so the antlers fill

    // space; every node grows a pair of short polyp stubs with a glowing bead;

    // every tip glows.

    //

    // Per-seed variation: facing, first length, shrink s (0.66..0.72), split

    // angle a (25..40), every roll.

    

    #define MIN 0.24

    

    // X 1, A: 1.9 * 0.74^n < 0.24 -> 7, tip 1, N 1. 10.

    #iterations: 12

    

    #axiom: X

    

    X -> /(rand(360)) !(0.18) F(rand(0.4,0.9)) A(rand(1.5,1.9), 0.18, rand(0.68,0.74), rand(25,40))

    

    A(l,w,s,a) : l >= MIN : 0.35 -> !(w*rand(0.85,1.2)) F(l*0.5*rand(0.7,1.3)) &(rand(-14,14)) +(rand(-14,14)) /(rand(-40,40)) F(l*0.5*rand(0.7,1.3)) N(w) [ +(a) /(rand(360)) A(l*s, w*0.7, s, a) ] [ -(a) /(rand(360)) A(l*s, w*0.7, s, a) ] [ ^(a) /(rand(360)) A(l*s*0.9, w*0.65, s, a) ]

    A(l,w,s,a) : l >= MIN : 0.65 -> !(w*rand(0.85,1.2)) F(l*0.5*rand(0.7,1.3)) &(rand(-14,14)) +(rand(-14,14)) /(rand(-40,40)) F(l*0.5*rand(0.7,1.3)) N(w) [ +(a) /(rand(360)) A(l*s, w*0.7, s, a) ] [ -(a) /(rand(360)) A(l*s, w*0.7, s, a) ]

    A(l,w,s,a) : l < MIN -> !(w) F(l) f(0.03) E(0.05 + w*0.6)

    

    // N(w): two polyp stubs at the node, on older wood only.

    N(w) : w > 0.04 -> [ /(rand(360)) &(70) !(0.006 + w*0.1) F(0.05 + w*0.4) f(0.015 + w*0.08) B(0.025 + w*0.12) ] [ /(rand(360)) &(70) !(0.006 + w*0.1) F(0.05 + w*0.4) f(0.015 + w*0.08) B(0.025 + w*0.12) ]

    N(w) : w <= 0.04 -> $'
  iterations: 12
