--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: BellowsGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Bellows colony. Five to eight bladder stalks ring a central chimney; each

    // stalk ends in a ridged bladder and throws two side-stalks with smaller

    // ridged bladders (two levels). The chimney is a thick kinked stalk with a

    // ring of breathing pores below its open funnel mouth and a glowing vent

    // inside; three to five feelers coil out between the bladders. (Plausible:

    // a colonial gas-exchange organ.)

    //

    // Per-seed variation: facing, stalk count, per stalk the kinks and bladder

    // sizes, sub-stalk counts, feeler coil, chimney height.

    

    // X 1, C 8, K 6 + 1, K 4 + 1, G 6 = 27; T 5, L 12 + 1. 27.

    #iterations: 30

    

    #axiom: X

    

    X -> /(rand(360)) !(0.14) F(0.2) [ C(rand(5,8)) ] [ T(rand(3,5)) ] !(0.22) H(rand(4,6), 0.3, 0.22)

    

    C(n) : n > 0 -> [ /(rand(360)) &(rand(50,80)) !(0.035) K(rand(4,6), 0.24, 0.035, 1) ] C(n-1)

    C(n) : n <= 0 -> $

    

    // K(k,l,w,v): a bladder stalk of level v.

    K(k,l,w,v) : k > 0 -> !(w*rand(0.85,1.2)) F(l*rand(0.7,1.3)) &(rand(-12,12)) +(rand(-12,12)) /(rand(-40,40)) $ ^(rand(6,12)) K(k-1, l, w, v)

    K(k,l,w,v) : k <= 0 && v > 0 -> [ +(rand(30,60)) /(rand(360)) K(rand(2,4), l*0.6, w*0.7, v-1) ] [ -(rand(30,60)) /(rand(360)) K(rand(2,4), l*0.6, w*0.7, v-1) ] f(l*0.8) B(l*2.4) G(6, l*2.4)

    K(k,l,w,v) : k <= 0 && v <= 0 -> f(l*0.8) B(l*2.4) G(6, l*2.4)

    

    // G(n,s): ridges on the bladder''s upper half.

    G(n,s) : n > 0 -> [ /(60*n) ^(rand(20,50)) f(s*0.42) J(s*0.5) ] G(n-1, s)

    G(n,s) : n <= 0 -> $

    

    // T(n): feelers: coils that tighten.

    T(n) : n > 0 -> [ /(rand(360)) &(rand(40,70)) !(0.012) L(rand(8,12), 0.15, 8, 0.012) ] T(n-1)

    T(n) : n <= 0 -> $

    L(k,l,a,w) : k > 0 -> !(w) F(l) &(a) /(rand(-8,8)) L(k-1, l*0.93, a*1.1, w*0.95)

    L(k,l,a,w) : k <= 0 -> !(w) F(l) f(0.03) V(0.05)

    

    // H(k,l,w): the chimney: kinked, then pores, mouth and vent.

    H(k,l,w) : k > 0 -> !(w*rand(0.85,1.2)) F(l*rand(0.7,1.3)) &(rand(-8,8)) +(rand(-8,8)) /(rand(-40,40)) $ ^(rand(4,10)) H(k-1, l, w*0.95)

    H(k,l,w) : k <= 0 -> !(w) F(0.2) P(6, w) F(0.15) f(0.3) M(0.7) f(0.1) V(0.12)

    P(n,w) : n > 0 -> [ /(60*n + rand(-10,10)) &(rand(60,80)) f(w*1.1) f(0.08) N(0.22) ] P(n-1, w)

    P(n,w) : n <= 0 -> $'
  iterations: 30
