MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: PagodaTreeGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Pagoda tree. One leader with a whorl of three tiered branches at every

    // node; each branch carries a branchlet pair per segment; each branchlet

    // carries leaflet cards and ends in a hanging glowing pod. Lower tiers are

    // longer, so the tree is a pagoda of layered fans.

    //

    // Per-seed variation: facing, trunk height, node count (5..8), per branch

    // the segment count, per branchlet the length.

    

    #define PHI 137.5

    

    // X 1, M 8 + 1, Y 4, B 12 + 1, H 5 + 1. 33.

    #iterations: 35

    

    #axiom: X

    

    X -> /(rand(360)) !(0.35) F(rand(0.8,1.6)) M(rand(5,8), 0.32)

    

    // M(k,w): the leader. k counts down, so the first whorls (k large) are lowest and longest.

    M(k,w) : k > 0 -> !(w*rand(0.88,1.12)) F(rand(0.9,1.3)) &(rand(-8,8)) +(rand(-8,8)) /(rand(-40,40)) $ ^(rand(0,3)) [ Y(3, 3, k) ] /(PHI) M(k-1, w*0.9)

    M(k,w) : k <= 0 -> !(w) F(0.5) f(0.2) E(0.25)

    

    // Y(n,t,k): the whorl: t branches, near horizontal.

    Y(n,t,k) : n > 0 -> [ /(360/t*n + rand(-8,8)) &(rand(80,100)) !(0.08) B(rand(4,6) + k*0.5, 0.35 + k*0.02) ] Y(n-1, t, k)

    Y(n,t,k) : n <= 0 -> $

    

    // B(m,l): tier branch, sagging a little, a branchlet pair per step.

    B(m,l) : m > 0 -> F(l*rand(0.75,1.25)) &(rand(2,5)) +(rand(-10,10)) /(rand(-20,20)) $ [ +(rand(50,70)) H(2, 0.24) ] [ -(rand(50,70)) H(2, 0.24) ] B(m-1, l*0.96)

    B(m,l) : m <= 0 -> F(l*0.5) H(2, 0.22)

    

    // H(q,l): branchlet with leaflet pairs, ending in a pod that hangs.

    H(q,l) : q > 0 -> !(0.02) F(l) [ +(65) f(0.06) L(0.14) ] [ -(65) f(0.06) L(0.14) ] H(q-1, l*0.95)

    H(q,l) : q <= 0 -> $ &(90) f(0.12) P(0.16)'
  iterations: 35
