%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: StriderGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Strider. A dark flattened body three metres up on eight to twelve long

    // crooked legs that spread wide and fork once before the ground, glowing

    // nodules along the legs; on top, five to eight coiling tentacle-leaves.

    //

    // Per-seed variation: facing, body height and size, leg count, every leg''s

    // launch, kinks and fork, nodule placement, tentacle count and coil.

    

    // X 1, E 12, R 11; X 1, C 8, K 14 + 1 = 24. 26.

    #iterations: 28

    

    #axiom: X

    

    X -> /(rand(360)) f(rand(2.5,3.5)) O(rand(0.9,1.3)) E(rand(8,12), 0.16) f(0.3) C(rand(5,8))

    

    E(n,w) : n > 0 -> [ /(rand(360)) &(rand(100,130)) R(rand(8,11), 0.6, w, rand(4,9), 0) ] E(n-1, w)

    E(n,w) : n <= 0 -> $

    

    // R(k,l,w,u,i): a leg: crooked, pulled to the ground, a nodule hook N, fork at k = 4.

    R(k,l,w,u,i) : k > 4.5 : 0.75 -> !(w*rand(0.85,1.2)) F(l*rand(0.6,1.4)) &(rand(-16,16)) +(rand(-16,16)) /(rand(-40,40)) $ &(u*rand(0.3,1.9)) N(i, w) R(k-1, l*0.97, w*0.93, u, i+1)

    R(k,l,w,u,i) : k > 4.5 : 0.25 -> !(w*rand(0.9,1.25)) F(l*rand(0.5,0.9)) /(rand(360)) &(rand(15,35)) $ &(u*rand(0.5,1.5)) N(i, w) R(k-1, l*0.97, w*0.93, u, i+1)

    R(k,l,w,u,i) : k > 3.5 && k <= 4.5 -> !(w) F(l*rand(0.7,1.1)) $ &(u) !(w*0.75) [ +(rand(20,40)) /(rand(-30,30)) R(k-1, l*0.95, w*0.75, u, i+1) ] [ -(rand(20,40)) /(rand(-30,30)) R(k-1, l*0.95, w*0.75, u, i+1) ]

    R(k,l,w,u,i) : k > 0 && k <= 3.5 : 0.75 -> !(w*rand(0.85,1.2)) F(l*rand(0.6,1.4)) &(rand(-16,16)) +(rand(-16,16)) /(rand(-40,40)) $ &(u*rand(0.3,1.9)) N(i, w) R(k-1, l*0.97, w*0.93, u, i+1)

    R(k,l,w,u,i) : k > 0 && k <= 3.5 : 0.25 -> !(w*rand(0.9,1.25)) F(l*rand(0.5,0.9)) /(rand(360)) &(rand(15,35)) $ &(u*rand(0.5,1.5)) N(i, w) R(k-1, l*0.97, w*0.93, u, i+1)

    R(k,l,w,u,i) : k <= 0 -> !(w) F(l*0.8)

    

    // N(i,w): a glowing nodule on the leg, four in ten segments.

    N(i,w) : 0.4 -> [ /(rand(360)) &(90) f(w*0.9) M(0.06 + w*0.8) ]

    N(i,w) : 0.6 -> $

    

    // C(n): tentacle-leaves from the top of the body: a coil that tightens.

    C(n) : n > 0 -> [ /(137.5*n) &(rand(10,50)) !(0.05) K(rand(10,14), 0.3, 6, 0.05) ] C(n-1)

    C(n) : n <= 0 -> $

    K(k,l,a,w) : k > 0 -> !(w) F(l) &(a) /(rand(-8,8)) [ +(75) f(l*0.4) L(l*0.8) ] [ -(75) f(l*0.4) L(l*0.8) ] K(k-1, l*0.93, a*1.12, w*0.95)

    K(k,l,a,w) : k <= 0 -> !(w) F(l) f(0.04) M(0.1)'
  iterations: 28
