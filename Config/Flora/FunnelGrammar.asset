--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: FunnelGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Noctiluca funnel (swamp mushroom, concept by Hans Ekaputra). A clump of

    // four to seven tall stalks from one base, each curving gently on its way up,

    // each flaring into a funnel-shaped cap holding a dense brush of luminous

    // blue bristles that stand up out of the funnel.

    //

    // Stalks are a repeated-segment rule (S), like the fern''s fronds: the shape

    // comes from many small random pitches and rolls, not from branching.

    //

    // Per-seed variation: stalk count, and per stalk the segment count, segment

    // length, width, cap size and bristle count.

    

    // C 4, S 14, K 1, B 7. 26.

    #iterations: 28

    

    #axiom: !(0.10) X

    

    X -> C(rand(4,7))

    

    C(n) : n > 0 -> [ /(rand(360)) &(rand(10,24)) S(rand(8,14), rand(0.2,0.28), rand(0.08,0.12)) ] [ /(rand(360)) &(rand(10,24)) S(rand(8,14), rand(0.2,0.28), rand(0.08,0.12)) ] C(n-2)

    C(n) : n <= 0 -> $

    

    // S(k, l, w): k segments left. Each one: draw, wobble, roll a little, then

    // roll upright and pitch slightly toward the sky so the stalk rights itself

    // (a little: at 3 degrees a step the stalks curved back and the caps met).

    // The last segment flares (!(w*2.4)) into the neck of the cap.

    S(k,l,w) : k > 0 -> !(w) F(l) &(rand(-5,5)) /(rand(-25,25)) $ ^(rand(0,1.2)) S(k-1, l*rand(0.97,1.03), w*0.97)

    S(k,l,w) : k <= 0 -> !(w*2.4) F(0.18) K(rand(0.45,0.65))

    

    // K(c): the cap, an open inverted cone (Funnel shape) 0.45*c tall centred

    // on its marker, so f(0.45*c) puts its apex on the stalk tip; the bristles

    // then start at the cap''s centre, inside the funnel.

    K(c) -> f(c*0.45) H(c) B(rand(4,7))

    

    // B(n): six bristles per step, nearly upright, fanning out no more than 24

    // degrees. f moves to the bristle''s centre first (cylinders are centred).

    B(n) : n > 0 -> [ /(rand(360)) &(rand(0,24)) f(0.19) T(0.38) ] [ /(rand(360)) &(rand(0,24)) f(0.22) T(0.44) ] [ /(rand(360)) &(rand(0,24)) f(0.17) T(0.34) ] [ /(rand(360)) &(rand(0,24)) f(0.20) T(0.40) ] [ /(rand(360)) &(rand(0,24)) f(0.23) T(0.46) ] [ /(rand(360)) &(rand(0,24)) f(0.18) T(0.36) ] B(n-1)

    B(n) : n <= 0 -> $

'
  iterations: 28
