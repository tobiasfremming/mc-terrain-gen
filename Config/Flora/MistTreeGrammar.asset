MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: MistTreeGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Mist comb. No trunk: a dark body on the ground throws ten to sixteen

    // crooked arms up and out in a spiral; every arm carries a comb of

    // filaments along its back and a fan of filaments at its end; filaments

    // sag, branch into side-hairs, and bead with droplets. (Plausible: a fog

    // comb, all surface and no wood.)

    //

    // Per-seed variation: facing, body size, arm count, per arm the pitch,

    // length and every kink, filament branching and droplets.

    

    #define PHI 137.5

    

    // X 1, A 16, K 9 + 1, W 8, H 4 + 1. 40.

    #iterations: 42

    

    #axiom: X

    

    X -> /(rand(360)) f(0.25) O(rand(0.7,1.0)) f(0.1) A(rand(10,16), 0.12)

    

    A(n,w) : n > 0 -> [ /(PHI*n) &(rand(20,75)) K(rand(6,9), 0.35, w, 0) ] A(n-1, w)

    A(n,w) : n <= 0 -> $

    

    // K(k,l,w,i): an arm: crooked, lifting; a comb tooth on every segment after

    // the first; a filament fan at the end.

    K(k,l,w,i) : k > 0 : 0.75 -> !(w*rand(0.85,1.2)) F(l*rand(0.7,1.3)) &(rand(-12,12)) +(rand(-12,12)) /(rand(-40,40)) $ ^(rand(3,7)) C(i, w) K(k-1, l, w*0.9, i+1)

    K(k,l,w,i) : k > 0 : 0.25 -> !(w*rand(0.9,1.25)) F(l*rand(0.5,0.9)) /(rand(360)) &(rand(15,30)) $ ^(rand(3,7)) C(i, w) K(k-1, l, w*0.9, i+1)

    K(k,l,w,i) : k <= 0 -> !(w) F(l*0.5) W(8, 8, rand(0.8,1.4))

    

    C(i,w) : i >= 1 -> [ ^(rand(60,90)) /(rand(-20,20)) !(0.005) H(3, 0.25) ]

    C(i,w) : i < 1 -> $

    

    W(n,t,l) : n > 0 -> [ /(360/t*n + rand(-8,8)) &(rand(40,100)) !(0.005) H(4, l/4) ] W(n-1, t, l)

    W(n,t,l) : n <= 0 -> $

    

    // H(k,l): a filament: sags, sometimes beads, sometimes throws a side-hair.

    H(k,l) : k > 0 : 0.5 -> F(l*rand(0.8,1.2)) &(rand(-8,8)) +(rand(-8,8)) $ &(4) H(k-1, l)

    H(k,l) : k > 0 : 0.3 -> F(l*rand(0.8,1.2)) &(rand(-8,8)) +(rand(-8,8)) $ &(4) D(0.03) H(k-1, l)

    H(k,l) : k > 0 : 0.2 -> F(l*rand(0.8,1.2)) [ +(rand(30,60)) !(0.004) F(l*0.8) f(0.015) D(0.03) ] $ &(4) H(k-1, l)

    H(k,l) : k <= 0 -> F(l*0.5) f(0.02) D(0.045)'
  iterations: 42
