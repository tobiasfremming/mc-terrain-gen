--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: TendrilTreeGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Tendril tree. A forking tree whose thin wood sprouts a coiling tendril at

    // every node and two at every tip; each tendril tightens as it goes, with a

    // leaf card pair per segment and a glowing bead at the end.

    //

    // Per-seed variation: facing, trunk height, first length, shrink s, every

    // fork angle, per tendril the length and coil rate.

    

    #define TP  0.72

    #define MIN 0.6

    

    // X 1, A: 2.3 * 0.78^n < 0.6 -> 6, tip 1, V 9 + 1. 18.

    #iterations: 20

    

    #axiom: X

    

    X -> /(rand(360)) !(0.55) F(rand(0.8,1.5)) &(rand(-5,5)) A(rand(1.8,2.3), 0.55, rand(0.72,0.78))

    

    // A(l,w,s): fork or fork-and-continue; thin nodes (w < 0.2) grow a tendril.

    A(l,w,s) : l >= MIN && w >= 0.2 : 0.6 -> !(w*rand(0.85,1.2)) F(l*0.5*rand(0.7,1.3)) &(rand(-16,16)) +(rand(-16,16)) /(rand(-40,40)) F(l*0.5*rand(0.7,1.3)) $ ^(3) !(w*TP) [ +(rand(25,45)) /(rand(360)) A(l*s, w*TP, s) ] [ -(rand(25,45)) /(rand(360)) A(l*s, w*TP, s) ]

    A(l,w,s) : l >= MIN && w >= 0.2 : 0.4 -> !(w*rand(0.85,1.2)) F(l*0.5*rand(0.7,1.3)) &(rand(-16,16)) +(rand(-16,16)) /(rand(-40,40)) F(l*0.5*rand(0.7,1.3)) $ ^(3) !(w*TP) [ +(rand(30,55)) /(rand(360)) A(l*s*0.9, w*TP*0.9, s) ] /(rand(-30,30)) A(l*s, w*TP, s)

    A(l,w,s) : l >= MIN && w < 0.2 : 0.6 -> !(w*rand(0.85,1.2)) F(l*0.5*rand(0.7,1.3)) &(rand(-16,16)) +(rand(-16,16)) /(rand(-40,40)) F(l*0.5*rand(0.7,1.3)) $ ^(3) [ ^(rand(40,70)) /(rand(360)) V(rand(7,9), 0.22, rand(8,12), w*0.4) ] !(w*TP) [ +(rand(25,45)) /(rand(360)) A(l*s, w*TP, s) ] [ -(rand(25,45)) /(rand(360)) A(l*s, w*TP, s) ]

    A(l,w,s) : l >= MIN && w < 0.2 : 0.4 -> !(w*rand(0.85,1.2)) F(l*0.5*rand(0.7,1.3)) &(rand(-16,16)) +(rand(-16,16)) /(rand(-40,40)) F(l*0.5*rand(0.7,1.3)) $ ^(3) [ &(rand(40,70)) /(rand(360)) V(rand(7,9), 0.22, rand(8,12), w*0.4) ] !(w*TP) [ +(rand(30,55)) /(rand(360)) A(l*s*0.9, w*TP*0.9, s) ] /(rand(-30,30)) A(l*s, w*TP, s)

    A(l,w,s) : l < MIN -> !(w) F(l) [ +(30) V(rand(8,10), 0.26, rand(8,12), w*0.8) ] [ -(30) /(rand(360)) V(rand(8,10), 0.26, rand(8,12), w*0.8) ]

    

    // V(k,l,a,w): a tendril: pitch a grows 8% a step, so it coils tighter.

    V(k,l,a,w) : k > 0 -> !(w) F(l) &(a) /(rand(-8,8)) [ +(75) f(l*0.4) L(l*0.9) ] [ -(75) f(l*0.4) M(l*0.9) ] V(k-1, l*0.94, a*1.08, w*0.95)

    V(k,l,a,w) : k <= 0 -> !(w) F(l) f(0.04) E(0.1)'
  iterations: 20
