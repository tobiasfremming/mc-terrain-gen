  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: NestedBloomGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Nested bloom. A flower whose petals carry smaller flowers at their tips,

    // whose petals carry smaller flowers again: one bloom rule at three levels

    // (v = 2, 1, 0), each half the size of the last, with a different petal

    // colour per level and a glowing boss at every centre.

    //

    // Per-seed variation: facing, stem height and lean, petal counts per bloom

    // (5..7), every petal angle.

    

    // X 1, B 1, W 7, B 1, W 7, B 1, W 7. 25.

    #iterations: 27

    

    #axiom: X

    

    X -> /(rand(360)) !(0.12) F(rand(0.8,1.6)) &(rand(-5,5)) !(0.1) F(0.4) B(2, 1.0)

    

    // B(v,s): a bloom: boss, then a whorl of petals.

    B(v,s) : v > 0 -> O(s*0.35) W(rand(5,7), 6, v, s)

    B(v,s) : v <= 0 -> D(s*0.3) W(6, 6, v, s)

    

    // W(n,t,v,s): one petal per step. Petal-bearing stalks at v > 0 end in a

    // child bloom; at v = 0 they are just petals.

    W(n,t,v,s) : n > 0 && v > 1.5 -> [ /(360/t*n + rand(-10,10)) &(rand(50,75)) !(s*0.03) F(s*0.45) L(s*1.3) F(s*0.45) ^(rand(30,60)) B(v-1, s*0.5) ] W(n-1, t, v, s)

    W(n,t,v,s) : n > 0 && v > 0.5 && v <= 1.5 -> [ /(360/t*n + rand(-10,10)) &(rand(50,75)) !(s*0.03) F(s*0.45) M(s*0.9) F(s*0.45) ^(rand(30,60)) B(v-1, s*0.5) ] W(n-1, t, v, s)

    W(n,t,v,s) : n > 0 && v <= 0.5 -> [ /(360/t*n + rand(-10,10)) &(rand(40,70)) f(s*0.45) N(s*0.9) ] W(n-1, t, v, s)

    W(n,t,v,s) : n <= 0 -> $

'
  iterations: 27
