MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e27993a11194c29b3db0e6c5a2c76a0, type: 3}
  m_Name: FanTreeGrammar
  m_EditorClassIdentifier: TerrainGen.LSystem::LSystems.LSystemGrammarAsset
  source: '// Arantoga fan tree (desert grove painting, flora board). A bottle trunk,

    // three or four heavy limbs, each ending in a knob that opens into a flat

    // vertical fan of paddle-shaped blades with fringed edges.

    //

    // The fan is built with pitches (^ and &) after $, so it lies in the vertical

    // plane through the limb. Blades are a midrib of segments; each segment

    // carries one paddle quad and four fringe quads.

    //

    // Per-seed variation: trunk segment count (2..4), three or four limbs

    // (X''s p parameter), limb segment counts, fan size (13..19 blades) and blade

    // length (5..8 segments).

    

    // Y 1, T 4 + 1, X 1, A 6 + 1, N 9 + 1, B 8 + 1. 33.

    #iterations: 35

    

    #axiom: Y

    

    Y -> /(rand(360)) !(1.35) T(rand(2,4), 1.35)

    

    // T(k,w): the bottle trunk, tapering fast.

    T(k,w) : k > 0 -> !(w) F(rand(0.5,0.85)) &(rand(-3,3)) /(rand(-20,20)) T(k-1, w*0.82)

    T(k,w) : k <= 0 -> !(w) X(rand(0,1))

    

    // X(p): four limbs or three.

    X(p) : p < 0.5 -> [ &(rand(22,38)) /(rand(360)) A(rand(3,6), 0.42) ] /(rand(100,150)) [ &(rand(25,40)) A(rand(3,6), 0.4) ] /(rand(100,150)) [ &(rand(15,30)) A(rand(4,6), 0.44) ] ^(rand(0,10)) A(rand(3,5), 0.48)

    X(p) : p >= 0.5 -> [ &(rand(22,40)) /(rand(360)) A(rand(3,6), 0.42) ] /(rand(140,220)) [ &(rand(25,40)) A(rand(4,6), 0.42) ] ^(rand(0,10)) A(rand(3,5), 0.46)

    

    // A(k,w): a limb, k segments, bending up as it goes.

    A(k,w) : k > 0 -> !(w) F(rand(0.7,1.0)) ^(rand(3,9)) /(rand(-15,15)) A(k-1, w*0.9)

    A(k,w) : k <= 0 -> !(w*1.4) F(0.4) O(w*3.2) $ N(rand(6,9))

    

    // N(i): the fan, two blades per step mirrored above and below the limb axis,

    // then the centre blade.

    N(i) : i > 0 -> [ ^(i*11 + rand(-3,3)) !(0.035) B(rand(5,8), 0.5, 1) ] [ &(i*11 + rand(-3,3)) !(0.035) B(rand(5,8), 0.5, 1) ] N(i-1)

    N(i) : i <= 0 -> [ !(0.035) B(rand(6,8), 0.5, 1) ]

    

    // B(k,l,j): a blade. j counts segments from the base: the first four carry

    // the wide paddle L, the rest the narrower M. Fringe quads Q both sides.

    B(k,l,j) : k > 0 && j <= 4 -> F(l*0.5) L(1) [ +(80) f(0.2) Q(0.42) ] [ -(80) f(0.2) Q(0.42) ] [ +(58) f(0.26) Q(0.5) ] [ -(58) f(0.26) Q(0.5) ] F(l*0.5) ^(rand(1,3)) B(k-1, l*0.97, j+1)

    B(k,l,j) : k > 0 && j > 4 -> F(l*0.5) M(1) [ +(80) f(0.16) Q(0.36) ] [ -(80) f(0.16) Q(0.36) ] [ +(58) f(0.22) Q(0.42) ] [ -(58) f(0.22) Q(0.42) ] F(l*0.5) ^(rand(1,3)) B(k-1, l*0.97, j+1)

    B(k,l,j) : k <= 0 -> f(0.1) P(0.5)

'
  iterations: 35
